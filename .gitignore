# FastAPI static uploads (user-generated)
static/uploads/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/.turbo/
frontend/.vercel/
frontend/out/
frontend/.env.local
frontend/.env*
frontend/tsconfig.tsbuildinfo

# Preview thumbnail cache (regenerated on demand)
static/cache/

# M3: one bind-mounted data directory holds the whole archive — the Postgres
# cluster, the uploads, the catalog art, the preview cache and the backups.
# Never commit any of it; `DATA_DIR` can point somewhere else entirely.
/data/

# A Next.js build started from the wrong directory lands here; never commit it.
.next/

# Screenshots are not committed: they show the machine they were taken on — the
# data directory (which contains the account name on a laptop), the LAN address,
# the hostname. Regenerate them locally with a neutral DATA_DIR; `git add -f` if
# you have looked at one and it is safe to publish.
screenshots/
