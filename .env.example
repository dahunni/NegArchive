# NegArchive — copy to .env and edit. Every line has a working default, so an
# empty .env (or none at all) still gives you `docker compose up`.
#
#   cp .env.example .env
#   docker compose up
#
# .env is git-ignored; this file is not. Never put a real password in here.

# --- Where the archive lives -------------------------------------------------
# One directory holds the database cluster, the uploads, the catalog art, the
# preview cache and the backups. Point it at a big disk if you have one.
DATA_DIR=./data

# --- Database ----------------------------------------------------------------
# Only reachable from the `web` container. Change the password before putting
# this on a network anyone else can see.
POSTGRES_USER=negarchive
POSTGRES_PASSWORD=negarchive
POSTGRES_DB=negarchive

# --- Uploads -----------------------------------------------------------------
# Largest accepted upload, in megabytes (R#18). A 16-bit 4000 dpi 35mm scan is
# around 250 MB, so the default leaves room for one but not for a DVD image.
MAX_UPLOAD_MB=512

# --- The UI ------------------------------------------------------------------
# Port on the host. http://localhost:8021
UI_PORT=8021
# The address to advertise in the footer and in the QR code. The container can
# only see its own bridge address (172.x), which is useless to a phone, so put
# the host's LAN IP or hostname here. Leave empty to let it guess.
NEGARCHIVE_PUBLIC_HOST=

# --- Optional shared password (R#26) -----------------------------------------
# Empty = no login, which is the default for a trusted home network. Set it and
# the whole API, /static included, needs the password once per browser.
NEGARCHIVE_PASSWORD=

# --- Import by reference and the watch folder --------------------------------
# The folder on the host that holds your scans. It is mounted read-only at
# /library inside the container; NegArchive never writes to it.
LIBRARY_HOST_DIR=./data/library
# Folders NegArchive may link files from, inside the container, separated by ":".
# EMPTY BY DEFAULT, which switches import by reference off entirely. Set it to
# /library to turn it on.
LIBRARY_ROOTS_ALLOW=
# Seconds between watch-folder sweeps. "off" or empty disables the poller.
WATCH_INTERVAL_SECONDS=30

# --- NegPy (M5) --------------------------------------------------------------
# Where NegArchive writes the files NegPy reads. Both are OPTIONAL: with nothing
# set they live inside the data directory (data/negpy/user, data/negpy/handoff),
# which works out of the box and is part of a backup.
#
# NEGPY_USER_DIR is the same variable NegPy itself reads; point it at NegPy's user
# directory (mounted into the container) and gear/*.json and presets/metadata/ are
# written straight into it. NEGPY_EXPORT_DIR is where "Open in NegPy" prepares a
# roll folder — a hard link needs it on the same filesystem as the data directory,
# otherwise the files are copied.
NEGPY_USER_DIR=
NEGPY_EXPORT_DIR=
# Extra folders the NegPy paths in Settings may point inside, separated by ":".
# The two variables above and LIBRARY_ROOTS_ALLOW are already allowed.
NEGPY_DIRS_ALLOW=

# --- Backups -----------------------------------------------------------------
# How many backup archives scripts/backup.sh keeps before deleting the oldest.
BACKUP_KEEP=7
